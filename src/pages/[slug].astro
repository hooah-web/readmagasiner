---
import Base from "../layouts/Base.astro";
import { magasiner, priser, TJENESTER, prisTekst, prisHoved, prisIntro, udvalgsStatus, afsnit, bladTekst, danskDato, seoTitel, seoBeskrivelse } from "../lib/site";
import Annonce from "../components/Annonce.astro";

export function getStaticPaths() {
  return magasiner.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const relevante = magasiner.filter((x) => x.slug !== m.slug && x.type === m.type).slice(0, 6);
const harNogen = m.digitalt.length > 0;
const tjekket = Object.values(priser)
  .map((p) => p.checked_at)
  .filter(Boolean)
  .sort()
  .pop();

const farver = ["#123B3A", "#202C36", "#153C60", "#5B3A2E", "#4A3B52", "#2F4858", "#6B4A3A", "#33452F"];
let h = 0;
for (let i = 0; i < m.slug.length; i++) h = (h * 31 + m.slug.charCodeAt(i)) % 9973;
const farve = farver[h % farver.length];
---

<Base
  title={seoTitel(m)}
  description={seoBeskrivelse(m)}
  jsonld={{
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Forside", item: "https://readmagasiner.dk/" },
      { "@type": "ListItem", position: 2, name: "Magasiner", item: "https://readmagasiner.dk/magasiner/" },
      { "@type": "ListItem", position: 3, name: m.navn },
    ],
  }}
>
  <section class="detail">
    <div class="container">
      <div class="bread">
        <a href="/">Forside</a> / <a href="/magasiner/">Magasiner</a> / {m.navn}
      </div>

      <div class="detailgrid">
        <div>
          <div class={`cover largecover ${m.cover ? "cover--billede" : ""}`} style={`background:${farve}`}>
            {m.cover && <img src={m.cover} alt={`Forside af ${m.navn}`} width="320" height="440" loading="eager" />}
            <small>{m.type === "ugeblad" ? "Ugeblad" : "Magasin"}</small>
            <strong>{m.navn}</strong>
            <em>{m.land === "DK" ? "Dansk udgivelse" : m.land}</em>
          </div>
          <div class="information">
            Genre: {m.maalgruppe ?? (m.type === "ugeblad" ? "Ugeblad" : "Magasin")}<br />
            Forlag: {m.forlag ?? "ikke oplyst"}<br />
            Sprog: {m.land === "DK" ? "Dansk" : m.land}
          </div>
        </div>

        <div>
          <h1>
            {m.navn}
            {m.lukket && <span class="tag no" style="vertical-align:middle;margin-left:10px;font-size:13px">Nedlagt</span>}
          </h1>
          <p class="meta" style="margin:0">
            {m.type === "ugeblad" ? "Ugeblad" : "Magasin"}
            {m.forlag ? ` · ${m.forlag}` : ""}
            {m.maalgruppe ? ` · ${m.maalgruppe}` : ""}
          </p>

          <div class="statusbox">
            <strong>
              {harNogen
                ? `Bladet er hos ${m.digitalt.length} af de ${TJENESTER.length} tjenester, vi sammenligner`
                : "Ingen af de tjenester, vi sammenligner, har bladet"}
            </strong>
            <p>
              {harNogen
                ? "Udvalget er sammenlignet med tjenesternes egne kataloger, som er vores sandhed. Står der \"Nej\", er bladet ikke på tjenestens liste."
                : "Det betyder ikke, at bladet er lukket — kun at det ikke står på Readlys, Flipps, Plings eller Wypes egne lister."}
            </p>
          </div>

          <h2>Hvor kan du læse {m.navn}?</h2>

          {TJENESTER.map((t) => {
            const p = priser[t.key];
            const hoved = prisHoved(p);
            const intro = prisIntro(p);
            const st = udvalgsStatus(m.slug, t.navn, m.ikke_digitalt);
            const tekst = st === "bekraeftet" ? "Ja · bekræftet" : st === "arv" ? "Ikke bekræftet" : st === "nej" ? "Nej" : "Ikke oplyst";
            return (
              <div class="availability">
                <b>{t.navn}</b>
                <div class="mid">
                  <span class={st === "bekraeftet" ? "tag" : st === "nej" ? "tag no" : "tag"} style={st === "bekraeftet" ? "" : "background:#F1F3EF;color:#536663"}>
                    {tekst}
                  </span>
                  <small>
                    {["Readly", "Flipp", "Pling", "Wype"].includes(t.navn)
                      ? `Tjekket ${danskDato(tjekket)} mod ${t.navn}s egen katalog`
                      : t.note}
                  </small>
                </div>
                <div class="cost">
                  {prisTekst(hoved)}
                  {intro && <span class="price__note">{intro.etikett ?? "tilbud"}: {prisTekst(intro)}</span>}
                </div>
                {st === "bekraeftet" ? (
                  <a class="btn btn--secondary" href={t.url} rel="nofollow sponsored noopener" target="_blank">
                    Se bladet hos {t.navn} →
                  </a>
                ) : (
                  <a class="small" href={`/tjenester/${t.key}/`}>Om {t.navn} →</a>
                )}
              </div>
            );
          })}

          <p class="meta" style="margin-top:14px">
            Vi sammenligner med tjenesternes egne kataloger. Står der "Ja", står bladet på tjenestens
            liste. Står der "Nej", gør det ikke. Listerne er tjekket 26. oktober 2026.
            {tjekket && ` Udvalg og priser tjekket ${danskDato(tjekket)}.`}
          </p>

          <h2>Få {m.navn} i postkassen</h2>
          {m.print ? (
            <div class="panel">
              <p class="meta" style="margin:0">
                {m.print.forlag === "Aller" ? "Aller Media" : "Story House Egmont"} · fysisk abonnement
              </p>
              <p class="price price--lg" style="margin:8px 0 0;color:var(--pine)">
                {m.print.pris_fra ? `fra ${m.print.pris_fra} kr.` : "Se pris hos forlaget"}
              </p>
              {m.print.udgivelser && <p class="meta" style="margin:6px 0 0">{m.print.udgivelser} udgivelser om året</p>}
              <p style="margin:16px 0 0">
                <a class="btn btn--secondary" href={m.print.url} rel="nofollow noopener" target="_blank">
                  Se abonnementet →
                </a>
              </p>
              <p class="meta" style="margin:14px 0 0">
                {m.print.pris_fra
                  ? `Prisen er forlagets egen "fra"-pris og kan dække flere abonnementstyper. Hentet ${m.print.tjekket} fra ${m.print.kilde}.`
                  : `Vi viser ikke en pris her, fordi forlagets side kræver JavaScript. Linket går til forlagets egen side. Tjekket ${m.print.tjekket}.`}
              </p>
            </div>
          ) : (
            <div class="panel" style="border-style:dashed">
              <p style="margin:0"><strong>Vi har ingen printaftale registreret på {m.navn}.</strong></p>
              <p class="meta" style="margin:8px 0 0">
                Bladet kan stadig købes i postkassen — vi har bare ikke fundet det hos Aller eller Egmont
                endnu. Vi viser ingen pris, vi ikke kan dokumentere.
              </p>
            </div>
          )}

          <h2>Om {m.navn}</h2>
          {bladTekst(m)
            ? <div class="detailcopy">
                {afsnit(bladTekst(m)).map((a) => <p>{a}</p>)}
              </div>
            : <div class="panel">
                <p style="margin:0">Vi har ikke en selvstændig beskrivelse af bladet endnu.</p>
                <p class="meta" style="margin:8px 0 0">
                  Bladet er registreret, fordi det findes i en af tjenesternes kataloger.
                  Vi skriver først en beskrivelse, når vi har et reelt grundlag for den.
                </p>
              </div>}
          <p class="meta" style="margin-top:14px">
            Beskrivelsen er skrevet af en AI på grundlag af bladets eget indhold og forlagets oplysninger.
            <a href="/om/">Sådan arbejder vi</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><Annonce slot="billboard" /></div>

  {relevante.length > 0 && (
    <section class="section white">
      <div class="container">
        <div class="sectiontitle">
          <h2>Andre {m.type === "ugeblad" ? "ugeblade" : "magasiner"}</h2>
          <a class="link" href="/magasiner/">Se alle →</a>
        </div>
        <div class="maggrid">
          {relevante.map((r) => (
            <a class="magcard" href={`/${r.slug}/`}>
              <div class={`cover ${r.cover ? "cover--billede" : ""}`} style={`background:${farver[(r.slug.length * 7) % farver.length]}`}>
                {r.cover && <img src={r.cover} alt={`Forside af ${r.navn}`} loading="lazy" width="300" height="420" />}
                <strong style="font-size:18px">{r.navn}</strong>
              </div>
              <h3>{r.navn}</h3>
              <div class="meta">{r.digitalt.length ? r.digitalt.join(" · ") : "Ikke digitalt"}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
