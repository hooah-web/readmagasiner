---
import Base from "../layouts/Base.astro";
import { magasiner, priser, TJENESTER, prisTekst, prisHoved, prisIntro, udvalgsStatus, afsnit, bladTekst } from "../lib/site";
import Annonce from "../components/Annonce.astro";

export function getStaticPaths() {
  return magasiner.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const relevante = magasiner.filter((x) => x.slug !== m.slug && x.type === m.type).slice(0, 6);
const harNogen = m.digitalt.length > 0;
const tjekket = Object.values(priser)
  .map((p) => p.checked_at)
  .filter(Boolean)
  .sort()
  .pop();
---

<Base
  title={`${m.navn} — digitalt eller i postkassen | readmagasiner.dk`}
  description={`${m.navn}${m.forlag ? ` fra ${m.forlag}` : ""}: se hvilke tjenester der har bladet digitalt, og hvad abonnementet koster. Priser tjekket af os.`}
>
  <div class="wrap" style="padding-top:26px">
    <p class="small">
      <a href="/">Forside</a> › <a href="/magasiner/">Blade</a> › <span>{m.navn}</span>
    </p>
  </div>

  <div class="wrap">
    <div class="layout">
      <div class="main">

        
        <article style="padding:18px 0 30px">
          <div style="display:flex;gap:22px;align-items:flex-start;margin-bottom:6px">
            {m.cover
              ? <img src={m.cover} alt={`Forside af ${m.navn}`} width="150" height="198" loading="eager"
                     style="width:150px;height:198px;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:#fff;flex:none" />
              : <div aria-hidden="true" style="width:150px;height:198px;border-radius:8px;flex:none;
                     background:linear-gradient(145deg,#123456,#0A63AE);color:#fff;display:flex;align-items:center;
                     justify-content:center;font-size:44px;font-weight:800;letter-spacing:-.03em">
                  {m.navn.slice(0,2).toUpperCase()}
                </div>}
            <div style="min-width:0">
          <h1 style="font-size:clamp(28px,4vw,44px)">
            {m.navn}
            {m.lukket && <span class="tag no" style="vertical-align:middle;margin-left:10px;font-size:13px">Nedlagt</span>}
          </h1>
          <p class="small" style="margin:10px 0 0">
            {m.type === "ugeblad" ? "Ugeblad" : "Magasin"}
            {m.forlag ? ` · ${m.forlag}` : ""}
            {m.maalgruppe ? ` · ${m.maalgruppe}` : ""}
            {m.land !== "DK" ? ` · ${m.land}` : ""}
          </p>
        <Annonce slot="mobile" />

            </div>
          </div>

          <h2 style="margin-top:32px">Læs {m.navn} digitalt</h2>
          {harNogen ? (
            <>
              <p class="small" style="margin:8px 0 16px">
                Bladet findes hos {m.digitalt.length} af de {TJENESTER.length} tjenester vi sammenligner.
              </p>
              <div class="tablewrap"><table>
                <thead>
                  <tr><th>Tjeneste</th><th>Har bladet</th><th>Pris</th><th></th></tr>
                </thead>
                <tbody>
                  {TJENESTER.map((t) => {
                    const p = priser[t.key];
                    const hoved = prisHoved(p);
                    const intro = prisIntro(p);
                    const st = udvalgsStatus(m.slug, t.navn, m.ikke_digitalt);
                    return (
                      <tr>
                        <td><strong>{t.navn}</strong></td>
                        <td>
                          {st === "bekraeftet"
                            ? <span class="tag">Ja · bekræftet</span>
                            : st === "arv"
                              ? <span class="pill">Ja · ikke bekræftet</span>
                              : st === "nej"
                                ? <span class="tag no">Nej</span>
                                : <span class="pill">Ikke oplyst</span>}
                        </td>
                        <td class="num">
                          {prisTekst(hoved)}
                          {intro && <div class="meta">{intro.etikett ?? "tilbud"}: {prisTekst(intro)}</div>}
                        </td>
                        <td>
                          <a href={t.url} rel="nofollow sponsored noopener" target="_blank" class="small">
                            Til {t.navn} →
                          </a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table></div>
              <p class="meta" style="margin-top:10px">
                Vi skriver "Ja", når vi har fundet bladet på tjenestens egen side, og "Ikke oplyst",
                når vi ikke ved det. Vi skriver aldrig "Nej", medmindre tjenesten selv oplyser det.
              </p>
              {tjekket && (
                <p class="meta" style="margin-top:10px">
                  Udvalg og priser tjekket {tjekket.slice(0, 10)} · udvalg kan ændre sig uden varsel
                </p>
              )}
            </>
          ) : (
            <div class="card" style="margin-top:14px">
              <p style="margin:0">
                <strong>{m.navn} findes ikke hos de tjenester, vi sammenligner.</strong>
              </p>
              <p class="small" style="margin:8px 0 0">
                Det betyder ikke, at bladet er lukket — kun at det ikke er med i Readly, Flipp, Pling eller Wype.
                Vi viser det alligevel, fordi et "nej" er et svar.
              </p>
            </div>
          )}

          <h2 style="margin-top:42px">Få {m.navn} i postkassen</h2>
          {m.print ? (
            <div class="card" style="margin-top:14px">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap">
                <div>
                  <p style="margin:0" class="small">{m.print.forlag === "Aller" ? "Aller Media" : "Story House Egmont"} · print</p>
                  <p class="price price--lg" style="margin:4px 0 0">
                    {m.print.pris_fra ? `fra ${m.print.pris_fra} kr.` : "Se pris hos forlaget"}
                  </p>
                  {m.print.udgivelser && (
                    <p class="small" style="margin:6px 0 0">{m.print.udgivelser} udgivelser om året</p>
                  )}
                </div>
                <a class="btn" href={m.print.url} rel="nofollow noopener" target="_blank">
                  Se abonnementet →
                </a>
              </div>
              <p class="meta" style="margin:12px 0 0">
                {m.print.pris_fra
                  ? `Prisen er forlagets egen "fra"-pris og kan dække flere abonnementstyper. Hentet ${m.print.tjekket} fra ${m.print.kilde}.`
                  : `Vi viser ikke en pris her, fordi forlagets side kræver JavaScript. Linket går til forlagets egen side. Tjekket ${m.print.tjekket}.`}
              </p>
            </div>
          ) : (
            <div class="card" style="margin-top:14px;border-style:dashed">
              <p style="margin:0"><strong>Vi har ingen printaftale registreret på {m.navn}.</strong></p>
              <p class="small" style="margin:8px 0 0">
                Bladet kan stadig købes i postkassen — vi har bare ikke fundet det hos Aller eller Egmont
                endnu. Vi viser ingen pris, vi ikke kan dokumentere.
              </p>
            </div>
          )}

          <h2 style="margin-top:42px">Om bladet</h2>
          {bladTekst(m)
            ? <div style="margin-top:10px;max-width:68ch">
                {afsnit(bladTekst(m)).map((a) => <p style="margin:0 0 12px">{a}</p>)}
              </div>
            : <div class="card" style="margin-top:12px">
                <p style="margin:0">Vi har ikke en selvstændig beskrivelse af bladet endnu.</p>
                <p class="small" style="margin:8px 0 0">
                  Bladet er registreret, fordi det findes i en af tjenesternes kataloger
                  {(m as any).kategori ? ` (kategori: ${(m as any).kategori})` : ""}.
                  Vi skriver først en beskrivelse, når vi har et reelt grundlag for den.
                </p>
              </div>}
          <p class="meta" style="margin-top:10px">
            Beskrivelsen er skrevet af en AI på grundlag af bladets eget indhold og forlagets oplysninger.
            <a href="/om/">Sådan arbejder vi</a>.
          </p>
        </article>

        {relevante.length > 0 && (
          <section style="padding-bottom:20px">
            <h2 style="font-size:22px">Andre {m.type === "ugeblad" ? "ugeblade" : "magasiner"}</h2>
            <div class="grid mag" style="margin-top:14px">
              {relevante.map((r) => (
                <a class="card" href={`/${r.slug}/`} style="text-decoration:none;color:inherit">
                  <h3 style="font-size:15.5px">{r.navn}</h3>
                  <p class="small" style="margin:5px 0 0">
                    {r.digitalt.length ? r.digitalt.join(" · ") : "Ikke digitalt"}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>

      <aside class="rail">
        <div class="sticky-rail">
          <Annonce slot="rail" />
        </div>
      </aside>
    </div>
  </div>
</Base>
