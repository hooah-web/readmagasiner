---
import Base from "../layouts/Base.astro";
import { magasiner, priser, TJENESTER, prisTekst, prisHoved, prisIntro, udvalgFor, tjenesteInfo } from "../lib/site";
---

<Base title="Sammenlign Readly, Flipp, Pling og Wype | readmagasiner.dk"
      description="Pris, udvalg og prøveperiode side om side. Se hvilken tjeneste der har flest af de blade, du læser.">
  <div class="wrap" style="padding-top:26px">
    <p class="small"><a href="/">Forside</a> › <span>Sammenlign</span></p>
  </div>
  <div class="wrap">
    <div class="layout">
      <div class="main">
        <div class="ad ad-mobile">300 × 250</div>
        <div style="padding:18px 0 10px">
          <h1 style="font-size:clamp(28px,4vw,42px)">Sammenlign tjenester</h1>
          <p class="lead" style="color:var(--ink-soft);max-width:60ch;margin-top:12px">
            Vi koncentrerer os om de danske udgivelser. Tjenesternes samlede udvalg er større,
            men består i høj grad af udenlandske titler, som ikke er relevante for danske læsere.
          </p>
        </div>
        <table style="margin:10px 0 30px">
          <thead><tr><th>Tjeneste</th><th>Pris</th><th>Danske udgivelser</th><th>Udenlandske</th><th>Prøveperiode</th></tr></thead>
          <tbody>
            {TJENESTER.map((t) => {
              const p = priser[t.key];
              const hoved = prisHoved(p);
              const intro = prisIntro(p);
              return (
                <tr>
                  <td><a href={"/tjenester/" + t.key + "/"}><strong>{t.navn}</strong></a></td>
                  <td class="num">{prisTekst(hoved)}</td>
                  <td class="num">{udvalgFor(t.navn).danske.length}</td>
                  <td class="num">
                    {tjenesteInfo[t.key].udenlandske_oplyst ?? <span class="small">ikke oplyst</span>}
                  </td>
                  <td>{intro ? prisTekst(intro) : <span class="small">ikke oplyst</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div class="ad ad-billboard">930 × 180</div>
      </div>
      <aside class="rail"><div class="sticky-rail"><div class="ad ad-rail">300 × 600</div></div></aside>
    </div>
  </div>
</Base>
