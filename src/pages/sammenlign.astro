---
import Base from "../layouts/Base.astro";
import { magasiner, priser, TJENESTER, prisTekst, prisHoved, prisIntro, udvalgFor, tjenesteInfo } from "../lib/site";
---

<Base title="Sammenlign Readly, Flipp, Pling og Wype | readmagasiner.dk"
      description="Pris, udvalg og prøveperiode side om side. Se hvilken tjeneste der har flest af de blade, du læser.">
  <div class="wrap" style="padding-top:26px">
    <p class="small"><a href="/">Forside</a> › <span>Sammenlign</span></p>
  </div>
  <div class="wrap">
    <div class="layout">
      <div class="main">
        <div class="ad ad-mobile">300 × 250</div>
        <div style="padding:18px 0 10px">
          <h1 style="font-size:clamp(28px,4vw,42px)">Sammenlign tjenester</h1>
          <p class="lead" style="color:var(--ink-soft);max-width:60ch;margin-top:12px">
            Vi koncentrerer os om de danske udgivelser. Tjenesternes samlede udvalg er større,
            men består i høj grad af udenlandske titler, som ikke er relevante for danske læsere.
          </p>
        </div>
        <table style="margin:10px 0 30px">
          <thead><tr><th>Tjeneste</th><th>Pris</th><th>Danske udgivelser</th><th>Udenlandske</th><th>Prøveperiode</th></tr></thead>
          <tbody>
            {TJENESTER.map((t) => {
              const p = priser[t.key];
              const hoved = prisHoved(p);
              const intro = prisIntro(p);
              return (
                <tr>
                  <td><a href={"/tjenester/" + t.key + "/"}><strong>{t.navn}</strong></a></td>
                  <td class="num">{prisTekst(hoved)}</td>
                  <td class="num">{udvalgFor(t.navn).danske.length}</td>
                  <td class="num">
                    {tjenesteInfo[t.key].udenlandske_oplyst ?? <span class="small">ikke oplyst</span>}
                  </td>
                  <td>{intro ? prisTekst(intro) : <span class="small">ikke oplyst</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>

        <h2 style="margin-top:34px">Hvad koster det dig — ud fra hvad du har i forvejen?</h2>
        <p class="small" style="margin:8px 0 14px">
          Alle fire annoncerer med 99 kr. Men prisen afhænger af, om du i forvejen abonnerer på et blad
          på papir. Det er den forskel, ingen af tjenesterne viser samlet.
        </p>
        <div class="pills" id="scenarier" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px">
          <button class="pill on" data-s="intet" type="button">Intet abonnement</button>
          <button class="pill" data-s="egmont" type="button">Egmont-blad</button>
          <button class="pill" data-s="aller" type="button">Aller-blad</button>
          <button class="pill" data-s="wype" type="button">Wype-blad</button>
        </div>
        <table>
          <thead><tr><th>Tjeneste</th><th>Din pris</th><th>Normalpris</th><th>Bemærkning</th></tr></thead>
          <tbody id="pristabel">
            <tr><td><a href="/tjenester/readly/"><strong>Readly</strong></a></td><td class="num">14,99 € ≈ 112 kr.</td><td class="num">14,99 € ≈ 112 kr.</td><td class="small">Opkræves i euro. 40 % rabat i 3 måneder: 8,99 € ≈ 67 kr.</td></tr>
            <tr><td><a href="/tjenester/flipp/"><strong>Flipp</strong></a></td><td class="num">99 kr.</td><td class="num">99 kr.</td><td class="small">3 måneder for 1 (99 kr.) eller 12 for 9 (891 kr.) som opstartsrabat.</td></tr>
            <tr><td><a href="/tjenester/pling/"><strong>Pling</strong></a></td><td class="num">99 kr.</td><td class="num">99 kr.</td><td class="small">Opsig senest 5 dage før næste betaling.</td></tr>
            <tr><td><a href="/tjenester/wype/"><strong>Wype</strong></a></td><td class="num">99 kr.</td><td class="num">99 kr.</td><td class="small">Første måned gratis.</td></tr>
          </tbody>
        </table>
        <p class="meta" style="margin-top:10px">
          Prishistorik fra tjenesternes egne FAQ'er, hentet 26. oktober 2026.
          <a href="/tjenester/flipp/">Flipp</a> · <a href="/tjenester/pling/">Pling</a> ·
          <a href="/tjenester/wype/">Wype</a> · <a href="/tjenester/readly/">Readly</a>
        </p>
        <script type="application/json" id="prisdata" set:html={JSON.stringify({
          readly: { navn: "Readly", normal: "14,99 € ≈ 112 kr.", note: "Opkræves i euro. 40 % rabat i 3 måneder: 8,99 € ≈ 67 kr." },
          flipp: { navn: "Flipp", normal: "99 kr.", note: "3 måneder for 1 (99 kr.) eller 12 for 9 (891 kr.) som opstartsrabat." },
          pling: { navn: "Pling", normal: "99 kr.", note: "Opsig senest 5 dage før næste betaling." },
          wype: { navn: "Wype", normal: "99 kr.", note: "Første måned gratis." }
        })} />
        <div class="ad ad-billboard">930 × 180</div>
      </div>
      <aside class="rail"><div class="sticky-rail"><div class="ad ad-rail">300 × 600</div></div></aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('prisdata').textContent);
      var scenarier = {
        intet:  {},
        egmont: { flipp: { pris: "39 kr.", note: "39 kr. som printabonnent på et Egmont-blad." } },
        aller:  { pling: { pris: "49 kr.", note: "49 kr. som printabonnent på et Aller-blad (Kombi)." } },
        wype:   { wype: { pris: "0 kr.", note: "Gratis digital adgang til det blad du abonnerer på. 59 kr./md. for resten." } }
      };
      var tbody = document.getElementById('pristabel');
      function render(s) {
        var sc = scenarier[s] || {};
        tbody.innerHTML = Object.keys(data).map(function (k) {
          var d = data[k], o = sc[k];
          var pris = o ? o.pris : d.normal;
          var note = o ? o.note : d.note;
          var farve = o ? 'color:var(--green);font-weight:750' : 'font-weight:650';
          return '<tr><td><a href="/tjenester/' + k + '/"><strong>' + d.navn + '</strong></a></td>' +
            '<td class="num" style="' + farve + '">' + pris + '</td>' +
            '<td class="num">' + d.normal + '</td>' +
            '<td class="small">' + note + '</td></tr>';
        }).join('');
      }
      document.querySelectorAll('#scenarier button').forEach(function (b) {
        b.addEventListener('click', function () {
          document.querySelectorAll('#scenarier button').forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on');
          render(b.dataset.s);
        });
      });
      render('intet');
    })();
  </script>
</Base>
