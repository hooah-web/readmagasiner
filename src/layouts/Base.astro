---
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  adsEnabled?: boolean;
}
const { title, description, adsEnabled = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://readmagasiner.dk");
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content="Astro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href="/">readmagasiner<b>.</b></a>
        <nav class="nav">
          <a href="/magasiner/">Alle magasiner</a>
          <a href="/tjenester/">Tjenester</a>
          <a href="/sammenlign/">Sammenlign</a>
          <a href="/om/">Om sitet</a>
        </nav>
        <span class="menu" aria-hidden="true">☰</span>
      </div>
    </header>

    <slot />

    <script is:inline>
      // Auto-forslag til søgefeltet. Henter indekset én gang pr. sidevisning.
      (function () {
        var inputs = document.querySelectorAll('input[data-autosuggest]');
        if (!inputs.length) return;
        var index = null, loading = false;

        function load(cb) {
          if (index) return cb();
          if (loading) return setTimeout(function () { load(cb); }, 100);
          loading = true;
          fetch('/soeg-index.json').then(function (r) { return r.json(); }).then(function (d) {
            index = d; loading = false; cb();
          }).catch(function () { loading = false; });
        }

        var norm = function (s) {
          return s.toLowerCase().replace(/æ/g, 'ae').replace(/ø/g, 'oe').replace(/å/g, 'aa');
        };

        inputs.forEach(function (input) {
          var box = document.createElement('div');
          box.className = 'suggest';
          var wrap = input.parentElement;
          wrap.classList.add('searchbox');
          wrap.appendChild(box);
          var items = [], active = -1;

          function render(term) {
            var t = norm(term.trim());
            if (t.length < 2) { box.classList.remove('open'); return; }
            load(function () {
              items = index.filter(function (x) { return norm(x.n).indexOf(t) > -1; }).slice(0, 8);
              active = -1;
              if (!items.length) {
                box.innerHTML = '<div class="empty">Ingen blade matcher "' + term + '"</div>';
              } else {
                box.innerHTML = items.map(function (x, i) {
                  return '<button type="button" data-i="' + i + '"><span class="nm">' + x.n + '</span><span class="tp">' +
                    (x.t === 'ugeblad' ? 'ugeblad' : 'magasin') + '</span></button>';
                }).join('');
              }
              box.classList.add('open');
            });
          }

          input.addEventListener('input', function () { render(input.value); });
          input.addEventListener('focus', function () { if (input.value.length >= 2) render(input.value); });
          input.addEventListener('keydown', function (e) {
            if (!box.classList.contains('open')) return;
            var btns = box.querySelectorAll('button');
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              e.preventDefault();
              if (!btns.length) return;
              active = e.key === 'ArrowDown' ? (active + 1) % btns.length : (active - 1 + btns.length) % btns.length;
              btns.forEach(function (b, i) { b.classList.toggle('active', i === active); });
            } else if (e.key === 'Enter' && active > -1) {
              e.preventDefault();
              location.href = '/' + items[active].s + '/';
            } else if (e.key === 'Escape') {
              box.classList.remove('open');
            }
          });
          box.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-i]');
            if (b) location.href = '/' + items[+b.dataset.i].s + '/';
          });
          document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target)) box.classList.remove('open');
          });
        });
      })();
    </script>

    <footer class="site-footer">
      <div class="container">
        <div class="footgrid">
          <div>
            <a class="logo" href="/" style="color:#fff">readmagasiner<b>.</b></a>
            <p style="margin-top:16px;max-width:36ch">
              Find magasiner, sammenlign tjenester, og se hvor du kan læse dine yndlingsblade.
              Vi sælger ikke abonnementer selv.
            </p>
          </div>
        </div>
        <div class="footend">
          <p style="margin:0 0 12px">
            <strong style="color:#fff">Anders har bestemt, hvordan sitet skal se ud, hvad det må indeholde, og hvilke regler der gælder.</strong>
            En AI har skrevet teksterne, bygget siderne og står for den daglige drift. Prishistorik og
            udvalg hentes automatisk fra tjenesternes egne sider og tjekkes løbende — hver pris viser
            datoen for sidste kontrol. Vi påstår ikke at have læst, testet eller abonneret på bladene.
          </p>
          © 2026 readmagasiner.dk · Drevet af Hooah AI
        </div>
      </div>
    </footer>
  </body>
</html>
