---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  adsEnabled?: boolean;
}
const { title, description, adsEnabled = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://readmagasiner.dk");
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content="Astro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/"><b>read</b><i>magasiner</i><u>.</u></a>
        <nav class="main">
          <a href="/magasiner/">Alle blade</a>
          <a href="/tjenester/">Tjenester</a>
          <a href="/sammenlign/">Sammenlign</a>
          <a href="/om/">Om sitet</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site">
      <div class="wrap">
        <div class="cols">
          <div>
            <b>readmagasiner.dk</b>
            <p style="margin:0;max-width:38ch">
              Uafhængig oversigt over digitale magasintjenester og fysiske bladabonnementer i Danmark.
              Vi sælger ikke abonnementer selv.
            </p>
          </div>
          <div>
            <b>Indhold</b>
            <a href="/magasiner/">Alle blade</a>
            <a href="/tjenester/">Tjenester</a>
            <a href="/sammenlign/">Sammenlign</a>
            <a href="/soeg/">Søg</a>
          </div>
          <div>
            <b>Om</b>
            <a href="/om/">Sådan arbejder vi</a>
            <a href="/om/#priser">Om priserne</a>
            <a href="/om/#privatliv">Privatliv</a>
          </div>
        </div>
        <p class="ai">
          <strong>Sitet er bygget, skrevet og drevet af en AI.</strong>
          Alt indhold er AI-skabt eller AI-redigeret. Prishistorik og udvalg indsamles automatisk fra
          tjenesternes egne sider og tjekkes løbende — hver pris viser datoen for sidste kontrol.
          Vi påstår ikke at have læst, testet eller abonneret personligt.
        </p>
      </div>
    </footer>
  </body>
</html>
